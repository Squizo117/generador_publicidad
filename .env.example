PORT=3000
NODE_ENV=development
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DATABASE_URL=postgresql://postgres:password@localhost:5432/generador_publicidad
# Supabase requires SSL. Download the root certificate from Database Settings > SSL Configuration.
DATABASE_SSL=true
DATABASE_SSL_CA_PATH=./certs/supabase-root.crt
# Comma-separated frontend origins. In development, localhost:5173 is allowed by default.
FRONTEND_ORIGINS=http://localhost:5173
